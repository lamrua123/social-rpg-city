{
  "name": "social-rpg-city",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5199 --strictPort",
    "dev:server": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "tsc -b && vite build && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "package:site": "node scripts/package-site.mjs",
    "smoke": "node scripts/multiplayer-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.468.0",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.102.0"
  }
}
