{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kindred-town",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CITY_HUB", "class_name": "CityHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CityHub"] }
  ]
}
